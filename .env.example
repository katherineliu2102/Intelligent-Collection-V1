SPRING_PROFILES_ACTIVE=local
# 格式：host:port（不要写 http:// 或 /nacos 后缀）
NACOS_SERVER_ADDR=
NACOS_NAMESPACE=
NACOS_GROUP=
NACOS_USERNAME=
NACOS_PASSWORD=
APP_PORT=8080

# Email / SMS / AI Call 密钥配置在 Nacos（勿写入 .env）：
#   intelligent-collection-local.yml → channel.sendgrid.api-key / from-email
#   intelligent-collection-local.yml → channel.notification.app-key
#   intelligent-collection-local.yml → channel.facade.api-key
# 模板 ID：Nacos 或 application-local.yml → channel.sendgrid.templates（scriptSlot → d-xxx）
# 可选的 local AI Call L1 非敏感参数；自签名证书只允许 local/test 使用。
# CHANNEL_FACADE_BASE_URL=
# CHANNEL_FACADE_TEST_CALLEE=
# CHANNEL_FACADE_INSECURE_TLS=false

# ── Pilot / 生产额外需要（复制为 .env.pilot 后填真值，该文件已 gitignore） ──
# 含 # 等特殊字符的口令必须加双引号，否则 docker-compose 可能按行内注释截断
# 下列带 [必填] 的键由 deploy/pilot-run.sh 启动前校验，缺一即拒启。
# [必填] 库连接；URL 含 & 时必须整体加双引号，否则 source 会在此截断
# SPRING_DATASOURCE_URL=""
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=""
# COLLECTION_REDIS_HOST=
# COLLECTION_REDIS_PORT=6379
# COLLECTION_REDIS_PASSWORD=""
# COLLECTION_REDIS_SSL=false
# COLLECTION_REDIS_STREAM=collection:pilot:events
# COLLECTION_REDIS_CONSUMER_GROUP=collection-engine-pilot
# GCP_PUBSUB_PROJECT=
# 案件接入订阅（业务消息）
# GCP_PUBSUB_SUBSCRIPTION=intelligent-collection-cases-v1-sub
# 调度专用订阅（Cloud Scheduler → Pub/Sub → 应用订阅）；必须与接入订阅分开，不得复用
# COLLECTION_SCHEDULER_ENABLED=true
# GCP_SCHEDULER_SUBSCRIPTION=intelligent-collection-schedule-v1-sub
# GOOGLE_APPLICATION_CREDENTIALS=/opt/app/secrets/credentials.json
# 两个白名单都要配：前者管「从 Pub/Sub 收哪些案件」，后者管「到期扫描从库里捞哪些案件」。
# 扫描不经过接入，只配前者的话共享库上仍会对全库到期步骤触达。
# COLLECTION_PILOT_LOAN_IDS=
# COLLECTION_SCAN_CASE_IDS=
# 仅 T6 全量切换时置 true；在此之前空名单一律按配置遗漏拒启
# COLLECTION_SCAN_ALLOW_FULL=false
# CHANNEL_CALLBACK_HMAC_SECRET=
# AI Call（Valubo Facade）。调度开启时三项皆为 [必填]，只接入不触达时可留空。
# callback-secret 是 Facade 账户级验签密钥，与上面的 CHANNEL_CALLBACK_HMAC_SECRET 不是同一把；
# 缺它则 /webhook/facade-callback 会把每条真实回调判成验签失败。
# CHANNEL_FACADE_BASE_URL=
# CHANNEL_FACADE_API_KEY=
# CHANNEL_FACADE_CALLBACK_SECRET=
# 会被渲染进 SMS 正文 / Push deep_link / Email payment_link 的还款地址，pilot profile 下必填。
# Phase 1 用 App 官方短链（全案件同一条）；换成 per-case 深链时占位符只支持 {caseId}。
# COLLECTION_REPAYMENT_URL_TEMPLATE=https://mocasa.com/s/4cTu
