<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="LOG_PATH" source="collection.logging.path" defaultValue="./logs/collection"/>
    <springProperty scope="context" name="LOG_FILE_NAME" source="collection.logging.file-name" defaultValue="collection.log"/>
    <springProperty scope="context" name="MAX_FILE_SIZE" source="collection.logging.max-file-size" defaultValue="100MB"/>
    <springProperty scope="context" name="MAX_HISTORY" source="collection.logging.max-history" defaultValue="30"/>
    <springProperty scope="context" name="TOTAL_SIZE_CAP" source="collection.logging.total-size-cap" defaultValue="10GB"/>

    <!-- job / scanId 是调度侧的键：ScheduledJobRunner 一直往 MDC 里放，但此前没写进本模式，
         于是 scanId 在任何一行日志里都看不到。T5-S6（多条 tick 里只有一个 scanId 走到「扫描完成」）
         与 T5-R11（调度日志带 job/scanId）都要靠它切分同一任务的多轮扫描，缺了就无从判读。
         两者只在调度线程上有值，其余日志按 `:-` 渲染成空，与既有四个键一致。 -->
    <property name="MDC_PATTERN" value="[event=%X{eventId:-} case=%X{caseId:-} plan=%X{planId:-} step=%X{stepId:-} job=%X{job:-} scan=%X{scanId:-}]"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} ${MDC_PATTERN} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE_ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} ${MDC_PATTERN} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <springProfile name="local">
        <logger name="com.collection" level="DEBUG"/>
    </springProfile>

    <springProfile name="dev,prod">
        <logger name="com.collection" level="INFO"/>
    </springProfile>
    

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_ROLLING"/>
    </root>
</configuration>

