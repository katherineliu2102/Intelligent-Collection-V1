target/
*.class
*.jar
*.war
.DS_Store
.idea/
*.iml
.settings/
.classpath
.project
.vscode/
.obsidian/
logs/
*.log
.env
# 各环境的填充版（.env.pilot 等）含真实地址与口令，只保留 .env.example 模板
.env.*
!.env.example
notification配置
nacos-publish.local.yml

# GCP 服务账号私钥（运维下发，绝不入仓）
credentials.json
*credentials*.json
*-sa.json
gcp-*.json
# 控制台下载的服务账号密钥默认叫 <project>-<keyId>.json，不含 credentials/sa 字样，
# 上面几条都盖不住，必须按项目名单独兜一条
fintech-all-*.json

# L4b 本地环境脚本（真值不入仓；保留 .example 模板）
scripts/test/l4b-env.local.sh

# deploy: 本地密钥与填充后的配置（仅保留 .example / .gitkeep）
deploy/secrets/*
!deploy/secrets/.gitkeep
deploy/nacos/nacos-publish.local.yml
# 发布脚本拉取的现网快照，含 JDBC 口令与渠道密钥
deploy/nacos/backup-*.yml
# 只读账号下落盘的合并结果（供控制台粘贴），同样含明文密钥
deploy/nacos/merged-*.yml
# 访问凭据速查（含明文口令），由个人自行保管，不入仓
docs/ops/*.local.md
node_modules/
collection-admin/ui/dist/
# Vite dev server 运行时临时文件（vite.config.local.ts.timestamp-*.mjs）
*.timestamp-*.mjs
__pycache__/
*.pyc

# scripts/dev 下划线前缀 = 本地临时草稿（跑批取证、一次性修复），不入仓
scripts/dev/_*

# Cursor 本地治理（hooks / skills / rules），不入远程
.cursor/
